# Plantilla de variables de entorno — copia este archivo como .env

# ---- Desarrollo local (SQLite) ----
# (la ruta es relativa a la carpeta prisma/, por eso el ../)
DATABASE_URL=file:../db/custom.db

# ---- Producción con Firebase Firestore (Vercel / Cloud Run) ----
# Motor de datos: "firestore" usa Firebase; vacío usa SQLite local.
# DATA_BACKEND=firestore
# FIREBASE_PROJECT_ID=car-cusco
# Credencial: pegar aquí el JSON completo de la cuenta de servicio de Firebase
# (tal cual se descarga, o el mismo contenido codificado en base64).
# FIREBASE_SERVICE_ACCOUNT=
# Alternativa por partes (si no se usa el JSON completo):
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ---- Inicio de sesión ----
# CAR_SECRETO=cadena-larga-y-secreta-para-firmar-la-sesion
# CAR_USUARIO=car
# CAR_CONTRASENA=contrasena-privada
